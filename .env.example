# Copy to .env and adjust. PM2 (ecosystem.config.cjs) also sets these.

# Port the Express app listens on (Nginx proxies to this).
PORT=3000

# Bind address. Keep 127.0.0.1 so only Nginx can reach it.
HOST=127.0.0.1

# Poll interval against NewsWeb, in milliseconds.
POLL_INTERVAL_MS=15000

# How many messages to request per poll from NewsWeb (steady state).
NEWSWEB_LIMIT=50

# Crash recovery: on the first poll after a (re)start, fetch this many messages so the
# poller can catch up anything published while it was down. This is a one-time fetch per
# start, so a larger value is fine. Bounds the recoverable gap: an outage that produced more
# than this many messages would lose the oldest ones beyond the limit.
CATCHUP_FETCH_LIMIT=200

# Only re-notify gap messages published within this window (ms) of the restart, so a long
# outage doesn't dump a burst of stale items. Default 6h. Widen for longer planned outages.
CATCHUP_WINDOW_MS=21600000

# Path to the desk config (keywords + webhooks). Defaults to ./desks-config.json
DESKS_CONFIG_PATH=./desks-config.json

# SQLite database file. Defaults to ./data/newsweb.db
DB_PATH=./data/newsweb.db

# Comma-separated list of allowed CORS origins for the dashboard.
# Set this to your Vercel deployment origin(s), e.g.:
# ALLOWED_ORIGINS=https://newsweb-monitor.vercel.app,https://newsweb.example.no
ALLOWED_ORIGINS=*

# IANA timezone used to compute "today" for the dashboard endpoints.
TZ_NAME=Europe/Oslo
